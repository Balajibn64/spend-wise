# Copy to .env (or export these as real environment variables) before running
# the backend. There are no built-in defaults for the DB password or JWT
# secret — the app fails fast at startup if they're missing, rather than
# silently falling back to a value that's sitting in git history.

DATABASE_URL=jdbc:postgresql://localhost:5432/spendwise
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

# Generate a real secret for anything beyond local dev, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-256-bit-value

PORT=8080
